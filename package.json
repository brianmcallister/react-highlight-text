{
  "name": "@brianmcallister/react-highlight-text",
  "version": "2.0.0",
  "description": "React component for highlighting words in text",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianmcallister/react-highlight-text.git"
  },
  "homepage": "https://brianmcallister.github.io/react-highlight-text/",
  "bugs": "https://github.com/brianmcallister/react-highlight-text/issues",
  "license": "MIT",
  "author": {
    "name": "Brian Wm. McAllister",
    "email": "brian@brianmcallister.com",
    "url": "https://www.brianmcallister.com"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "highlight",
    "highlight-text",
    "mark",
    "search",
    "react",
    "react-component"
  ],
  "scripts": {
    "build": "tsup",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "lint:package": "publint",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@brianmcallister/highlight-text": "^3.0.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "publint": "0.3.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
